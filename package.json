{
  "name": "dsh-lan-proxy",
  "version": "1.3.0",
  "description": "dsh LAN/public reverse proxy plugin: IP whitelist, one-time login codes, device management, access log. Runs inside the dsh process; dual-stack IPv4/IPv6.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "docs",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "reverse-proxy",
    "lan",
    "ipv6",
    "one-time-code",
    "device-management",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariGoIds/dsh-lan-proxy.git"
  },
  "homepage": "https://github.com/mariGoIds/dsh-lan-proxy#readme",
  "bugs": {
    "url": "https://github.com/mariGoIds/dsh-lan-proxy/issues"
  },
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
