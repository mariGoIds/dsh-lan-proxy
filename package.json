{
  "name": "dsh-lan-proxy",
  "version": "0.3.0",
  "description": "dsh LAN/public reverse proxy plugin: IP whitelist + Basic Auth + access log, runs inside the dsh process. Dual-stack (IPv4/IPv6).",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "reverse-proxy",
    "lan",
    "ipv6",
    "basic-auth",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariGoIds/dsh-lan-proxy.git"
  },
  "homepage": "https://github.com/mariGoIds/dsh-lan-proxy#readme",
  "bugs": {
    "url": "https://github.com/mariGoIds/dsh-lan-proxy/issues"
  },
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
